<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kai Topup · Honor of Kings</title>
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: linear-gradient(145deg, #0b0e14 0%, #141a24 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem 3rem;
      color: #eef2f6;
    }

    .app-container {
      max-width: 820px;
      width: 100%;
      margin: 0 auto;
    }

    /* header */
    .logo-area {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 1.8rem;
      padding-top: 0.5rem;
    }

    .logo-icon {
      background: linear-gradient(135deg, #f5b342, #e08e1a);
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 12px 25px -8px rgba(245, 179, 66, 0.5);
    }

    .logo-icon i {
      font-size: 28px;
      color: #0b0e14;
    }

    .logo-text {
      font-size: 2.1rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #ffffff, #d9e2f0);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .logo-text span {
      background: linear-gradient(to right, #f5b342, #f7c56e);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .game-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: #1f2a38;
      padding: 0.8rem 1.8rem;
      border-radius: 100px;
      border: 1px solid #2e3b4e;
      margin-bottom: 2rem;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    }

    .game-badge i {
      color: #f5b342;
      font-size: 1.7rem;
    }

    .game-badge h2 {
      font-weight: 600;
      font-size: 1.35rem;
      letter-spacing: 0.3px;
      color: #eef2f6;
    }

    /* pack grid */
    .pack-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      margin: 1.5rem 0 1rem;
    }

    .pack-card {
      background: #1c232e;
      border: 1px solid #2d3848;
      border-radius: 18px;
      padding: 1rem 1rem 1rem 1.2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.4);
      position: relative;
    }

    .pack-card:hover {
      background: #232d3c;
      border-color: #f5b342;
      transform: translateY(-2px);
      box-shadow: 0 14px 22px -8px rgba(245, 179, 66, 0.25);
    }

    .pack-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .pack-name {
      font-weight: 600;
      font-size: 0.95rem;
      color: #dfe7f0;
      line-height: 1.3;
    }

    .pack-tokens {
      font-size: 0.78rem;
      font-weight: 500;
      color: #8f9eb0;
      letter-spacing: 0.2px;
    }

    .pack-tokens i {
      margin-right: 5px;
      color: #f5b342;
      font-size: 0.8rem;
    }

    .pack-price {
      font-weight: 700;
      font-size: 1.15rem;
      color: #f5b342;
      white-space: nowrap;
      margin-left: 8px;
    }

    /* ----- order panel (modal style) ----- */
    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 1000;
    }

    .overlay.active {
      display: flex;
    }

    .order-panel {
      background: #151d28;
      border: 1px solid #2c384b;
      border-radius: 32px;
      max-width: 540px;
      width: 100%;
      padding: 2rem 1.8rem 2rem;
      box-shadow: 0 30px 50px rgba(0, 0, 0, 0.8);
      position: relative;
      max-height: 92vh;
      overflow-y: auto;
    }

    .order-panel::-webkit-scrollbar {
      width: 6px;
    }

    .order-panel::-webkit-scrollbar-thumb {
      background: #3a4a60;
      border-radius: 10px;
    }

    .close-btn {
      position: absolute;
      top: 18px;
      right: 20px;
      background: none;
      border: none;
      color: #8f9eb0;
      font-size: 1.6rem;
      cursor: pointer;
      transition: 0.2s;
      line-height: 1;
    }

    .close-btn:hover {
      color: #ffffff;
    }

    .selected-pack {
      background: #1f2a38;
      border-radius: 16px;
      padding: 0.9rem 1.2rem;
      margin: 0.5rem 0 1.4rem;
      border-left: 5px solid #f5b342;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .selected-pack span:first-child {
      font-weight: 500;
      color: #b6c3d4;
    }

    .selected-pack strong {
      color: #f5b342;
      font-size: 1.1rem;
    }

    .field-group {
      margin-bottom: 1.6rem;
    }

    .field-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #9aa9bb;
      margin-bottom: 7px;
    }

    .field-group input {
      width: 100%;
      background: #0f1721;
      border: 1.5px solid #2d3b4d;
      border-radius: 14px;
      padding: 14px 16px;
      font-size: 1rem;
      color: #ffffff;
      outline: none;
      transition: 0.15s;
      font-weight: 500;
    }

    .field-group input:focus {
      border-color: #f5b342;
      box-shadow: 0 0 0 3px rgba(245, 179, 66, 0.2);
    }

    .field-group input::placeholder {
      color: #5d6e82;
      font-weight: 400;
      font-size: 0.9rem;
    }

    .payment-box {
      background: #0f1721;
      border-radius: 18px;
      padding: 1rem 1.2rem;
      border: 1px dashed #3a4b61;
      margin-bottom: 1.6rem;
    }

    .payment-box p {
      font-size: 0.85rem;
      color: #8b9bb0;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .payment-box p i {
      color: #f5b342;
    }

    .number-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #1c2733;
      padding: 10px 12px 10px 16px;
      border-radius: 12px;
    }

    .number-row .number {
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: #ffffff;
    }

    .copy-btn {
      background: #2e3b4e;
      border: none;
      color: #ffffff;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: 0.15s;
    }

    .copy-btn:hover {
      background: #3f5068;
    }

    .copy-btn i {
      font-size: 0.9rem;
    }

    .copy-feedback {
      font-size: 0.75rem;
      color: #64d8a0;
      margin-top: 5px;
      height: 18px;
      transition: 0.2s;
    }

    .screenshot-area {
      background: #0f1721;
      border-radius: 18px;
      padding: 1.2rem;
      margin: 1.2rem 0 1.6rem;
      border: 1px solid #2b384a;
    }

    .screenshot-area p {
      font-size: 0.9rem;
      margin-bottom: 10px;
      color: #b6c3d4;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .screenshot-area p i {
      color: #f5b342;
    }

    .file-input-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .file-input-wrapper input[type="file"] {
      display: none;
    }

    .file-label {
      background: #202c3a;
      border: 1px solid #3a4b61;
      border-radius: 12px;
      padding: 12px 18px;
      font-size: 0.9rem;
      font-weight: 500;
      color: #ccd9e8;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: 0.15s;
      flex: 1;
    }

    .file-label:hover {
      background: #2a3849;
      border-color: #f5b342;
    }

    .file-label i {
      color: #f5b342;
    }

    .file-name {
      font-size: 0.8rem;
      color: #7f91a8;
      margin-top: 8px;
      word-break: break-word;
    }

    .order-btn {
      width: 100%;
      background: linear-gradient(135deg, #f5b342, #e09e2c);
      border: none;
      padding: 17px 20px;
      border-radius: 18px;
      font-size: 1.1rem;
      font-weight: 700;
      color: #0b0e14;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 12px 25px -8px rgba(245, 179, 66, 0.4);
      margin-top: 0.5rem;
    }

    .order-btn:hover {
      background: linear-gradient(135deg, #f7c05a, #ecab36);
      transform: scale(1.01);
    }

    .order-btn:active {
      transform: scale(0.99);
    }

    .order-btn i {
      font-size: 1.3rem;
    }

    .error-msg {
      color: #f87171;
      font-size: 0.85rem;
      font-weight: 500;
      margin-top: 8px;
      display: none;
      align-items: center;
      gap: 5px;
    }

    .error-msg i {
      font-size: 0.9rem;
    }

    /* success message */
    .success-toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #1f3b2c;
      border-left: 6px solid #64d8a0;
      padding: 16px 30px;
      border-radius: 16px;
      color: #d2f0e0;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 20px 35px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transition: 0.35s ease;
      z-index: 2000;
      pointer-events: none;
    }

    .success-toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .success-toast i {
      font-size: 1.7rem;
      color: #64d8a0;
    }

    /* login prompt */
    .login-prompt {
      background: #1c2532;
      border-radius: 14px;
      padding: 12px 18px;
      font-size: 0.9rem;
      color: #b6c3d4;
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid #35465c;
      margin-bottom: 1.2rem;
      cursor: pointer;
      transition: 0.15s;
    }

    .login-prompt:hover {
      background: #253141;
      border-color: #f5b342;
    }

    .login-prompt i {
      color: #f5b342;
      font-size: 1.2rem;
    }

    .login-prompt strong {
      color: #ffffff;
    }

    /* responsive */
    @media (max-width: 480px) {
      .pack-grid {
        grid-template-columns: 1fr;
      }

      .logo-text {
        font-size: 1.8rem;
      }

      .order-panel {
        padding: 1.6rem 1.2rem;
      }

      .selected-pack {
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
      }
    }
  </style>
</head>
<body>
  <div class="app-container">
    <!-- Logo -->
    <div class="logo-area">
      <div class="logo-icon">
        <i class="fas fa-crown"></i>
      </div>
      <div class="logo-text">Kai <span>Topup</span></div>
    </div>

    <!-- Game Badge -->
    <div class="game-badge">
      <i class="fas fa-gamepad"></i>
      <h2>Honor of Kings</h2>
    </div>

    <!-- Pack Grid (populated by JS) -->
    <div class="pack-grid" id="packGrid"></div>
  </div>

  <!-- Order Overlay (Modal) -->
  <div class="overlay" id="overlay">
    <div class="order-panel" id="orderPanel">
      <button class="close-btn" id="closeOverlay">&times;</button>
      <h3 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.3rem;">Complete order</h3>
      <p style="color: #8b9bb0; font-size: 0.9rem; margin-bottom: 1.2rem;">Honor of Kings · Top-up</p>

      <!-- Login prompt (simulated, shown if not "logged in") -->
      <div class="login-prompt" id="loginPrompt">
        <i class="fas fa-user-circle"></i>
        <span>Please <strong>log in</strong> or <strong>sign up</strong> to continue. (Tap here to simulate)</span>
      </div>

      <!-- Selected pack info -->
      <div class="selected-pack" id="selectedPackInfo">
        <span>Selected pack</span>
        <strong id="selectedPackName">—</strong>
      </div>

      <!-- UID input -->
      <div class="field-group">
        <label><i class="fas fa-id-card" style="margin-right: 6px;"></i> Honor of Kings UID</label>
        <input type="text" id="uidInput" placeholder="Enter your UID (e.g. 123456789)" autocomplete="off" />
      </div>

      <!-- Payment info -->
      <div class="payment-box">
        <p><i class="fas fa-mobile-alt"></i> Send payment to (bKash / Nagad)</p>
        <div class="number-row">
          <span class="number" id="paymentNumber">01981945912</span>
          <button class="copy-btn" id="copyBtn"><i class="far fa-copy"></i> Copy</button>
        </div>
        <div class="copy-feedback" id="copyFeedback"></div>
      </div>

      <!-- Transaction ID -->
      <div class="field-group">
        <label><i class="fas fa-receipt" style="margin-right: 6px;"></i> Transaction ID</label>
        <input type="text" id="trxInput" placeholder="e.g. TXN123456789" autocomplete="off" />
      </div>

      <!-- Screenshot upload -->
      <div class="screenshot-area">
        <p><i class="fas fa-camera"></i> Upload payment screenshot</p>
        <div class="file-input-wrapper">
          <input type="file" id="screenshotInput" accept="image/*" />
          <label for="screenshotInput" class="file-label" id="fileLabel">
            <i class="fas fa-cloud-upload-alt"></i> Choose screenshot
          </label>
        </div>
        <div class="file-name" id="fileName">No file selected</div>
      </div>

      <!-- Error message -->
      <div class="error-msg" id="errorMsg"><i class="fas fa-exclamation-circle"></i> <span id="errorText"></span></div>

      <!-- Order button -->
      <button class="order-btn" id="placeOrderBtn">
        <i class="fas fa-check-circle"></i> Place order
      </button>
    </div>
  </div>

  <!-- Success toast -->
  <div class="success-toast" id="successToast">
    <i class="fas fa-check-circle"></i>
    <span id="successMessage">Order placed! Tokens will be added after verification.</span>
  </div>

  <script>
    (function() {
      // ---------- PACK DATA (Token value + price) ----------
      const packs = [
        { name: "Double Token Lucky Bag", tokens: "Double Token Lucky Bag", price: "৳54" },
        { name: "Honor Point Value Pack", tokens: "Honor Point Value Pack", price: "৳54" },
        { name: "Standard Purchase Rebate Pack", tokens: "Standard Purchase Rebate Pack", price: "৳54" },
        { name: "Premium Purchase Rebate Pack", tokens: "Premium Purchase Rebate Pack", price: "৳176" },
        { name: "Weekly Card", tokens: "Weekly Card", price: "৳142" },
        { name: "Weekly Card Plus", tokens: "Weekly Card Plus", price: "৳412" },
        { name: "16 Tokens", tokens: "16 Tokens", price: "৳32" },
        { name: "80 Tokens", tokens: "80 Tokens", price: "৳134" },
        { name: "240 Tokens", tokens: "240 Tokens", price: "৳364" },
        { name: "400 Tokens", tokens: "400 Tokens", price: "৳596" },
        { name: "560 Tokens", tokens: "560 Tokens", price: "৳832" },
        { name: "830 Tokens", tokens: "830 Tokens", price: "৳1,199" },
        { name: "1245 Tokens", tokens: "1245 Tokens", price: "৳1,782" },
        { name: "2508 Tokens", tokens: "2508 Tokens", price: "৳3,552" },
        { name: "4180 Tokens", tokens: "4180 Tokens", price: "৳5,909" },
        { name: "8360 Tokens", tokens: "8360 Tokens", price: "৳11,819" }
      ];

      // ---------- DOM refs ----------
      const packGrid = document.getElementById('packGrid');
      const overlay = document.getElementById('overlay');
      const closeOverlayBtn = document.getElementById('closeOverlay');
      const selectedPackName = document.getElementById('selectedPackName');
      const uidInput = document.getElementById('uidInput');
      const trxInput = document.getElementById('trxInput');
      const screenshotInput = document.getElementById('screenshotInput');
      const fileNameDisplay = document.getElementById('fileName');
      const fileLabel = document.getElementById('fileLabel');
      const copyBtn = document.getElementById('copyBtn');
      const paymentNumber = document.getElementById('paymentNumber');
      const copyFeedback = document.getElementById('copyFeedback');
      const placeOrderBtn = document.getElementById('placeOrderBtn');
      const errorMsg = document.getElementById('errorMsg');
      const errorText = document.getElementById('errorText');
      const successToast = document.getElementById('successToast');
      const successMessage = document.getElementById('successMessage');
      const loginPrompt = document.getElementById('loginPrompt');

      // ---------- State ----------
      let selectedPack = null;          // stores the pack object
      let isLoggedIn = false;           // simulated login state
      let currentScreenshotFile = null;

      // ---------- Render packs ----------
      function renderPacks() {
        packGrid.innerHTML = '';
        packs.forEach((pack, index) => {
          const card = document.createElement('div');
          card.className = 'pack-card';
          card.dataset.index = index;
          card.innerHTML = `
            <div class="pack-info">
              <div class="pack-name">${pack.name}</div>
              <div class="pack-tokens"><i class="fas fa-coins"></i> ${pack.tokens}</div>
            </div>
            <div class="pack-price">${pack.price}</div>
          `;
          card.addEventListener('click', () => openOrderPanel(pack));
          packGrid.appendChild(card);
        });
      }

      // ---------- Open order panel ----------
      function openOrderPanel(pack) {
        // Require login (simulated)
        if (!isLoggedIn) {
          // Show login prompt & do not open order panel
          loginPrompt.style.borderColor = '#f5b342';
          loginPrompt.style.background = '#2a2f3a';
          loginPrompt.scrollIntoView({ behavior: 'smooth', block: 'center' });
          // Briefly animate
          loginPrompt.animate([
            { transform: 'scale(1)' },
            { transform: 'scale(1.02)' },
            { transform: 'scale(1)' }
          ], { duration: 300 });
          return;
        }

        selectedPack = pack;
        selectedPackName.textContent = `${pack.name} — ${pack.price}`;
        // Reset fields
        uidInput.value = '';
        trxInput.value = '';
        screenshotInput.value = '';
        fileNameDisplay.textContent = 'No file selected';
        currentScreenshotFile = null;
        errorMsg.style.display = 'none';
        copyFeedback.textContent = '';
        overlay.classList.add('active');
        uidInput.focus();
      }

      // Close overlay
      function closeOverlay() {
        overlay.classList.remove('active');
        selectedPack = null;
      }

      // ---------- Copy number ----------
      copyBtn.addEventListener('click', () => {
        const number = paymentNumber.textContent.trim();
        navigator.clipboard.writeText(number).then(() => {
          copyFeedback.textContent = '✓ Number copied!';
          setTimeout(() => { copyFeedback.textContent = ''; }, 2500);
        }).catch(() => {
          // fallback
          const range = document.createRange();
          range.selectNode(paymentNumber);
          window.getSelection().removeAllRanges();
          window.getSelection().addRange(range);
          document.execCommand('copy');
          copyFeedback.textContent = '✓ Number copied!';
          setTimeout(() => { copyFeedback.textContent = ''; }, 2500);
        });
      });

      // ---------- File input handling ----------
      screenshotInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          currentScreenshotFile = file;
          fileNameDisplay.textContent = file.name;
          fileLabel.style.borderColor = '#64d8a0';
        } else {
          currentScreenshotFile = null;
          fileNameDisplay.textContent = 'No file selected';
          fileLabel.style.borderColor = '#3a4b61';
        }
      });

      // ---------- Simulate login (click on login prompt) ----------
      loginPrompt.addEventListener('click', () => {
        isLoggedIn = true;
        loginPrompt.style.borderColor = '#64d8a0';
        loginPrompt.style.background = '#1f3b2c';
        loginPrompt.innerHTML = `<i class="fas fa-check-circle" style="color:#64d8a0;"></i> <span>Logged in as <strong>KaiPlayer</strong> (simulated)</span>`;
        // If there's a pending pack (user clicked a pack while not logged in), we can re-open? 
        // Better: just close the prompt state.
        // Also if overlay is open we could do nothing. But we don't store pending pack.
      });

      // ---------- Order validation & submission ----------
      placeOrderBtn.addEventListener('click', () => {
        // Clear previous errors
        errorMsg.style.display = 'none';

        // 1. Check UID
        const uid = uidInput.value.trim();
        if (!uid) {
          showError('Please enter your Honor of Kings UID.');
          uidInput.focus();
          return;
        }

        // 2. Check Transaction ID (basic pattern: alphanumeric, length >=6)
        const trx = trxInput.value.trim();
        const trxPattern = /^[A-Za-z0-9]{6,}$/;
        if (!trx) {
          showError('Please enter your Transaction ID.');
          trxInput.focus();
          return;
        }
        if (!trxPattern.test(trx)) {
          showError('Transaction ID looks invalid. Use at least 6 letters/numbers (no spaces).');
          trxInput.focus();
          return;
        }

        // 3. Check screenshot uploaded
        if (!currentScreenshotFile) {
          showError('Please upload the payment screenshot.');
          document.querySelector('.file-label').scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // 4. Verify pack selected
        if (!selectedPack) {
          showError('No pack selected. Please close and choose a pack.');
          return;
        }

        // 5. Simulate "auto-detection" of transaction ID (the prompt says: "Ai auto matic ditect orbe je di transec id sonthik na bhul")
        // We'll simulate a check: reject if transaction ID contains '000' (just for demo) or is too short.
        // But we already checked length >=6. To mimic "auto-detect", we'll show a random success unless it contains "000".
        if (trx.includes('000')) {
          showError('Transaction ID could not be verified. Please check and try again (simulated detection).');
          return;
        }

        // All good — simulate successful order
        // In a real backend, you'd upload screenshot + data.

        // Show success toast
        successMessage.textContent = `✅ Order placed for ${selectedPack.name}! Tokens will be added after manual verification.`;
        successToast.classList.add('show');
        setTimeout(() => {
          successToast.classList.remove('show');
        }, 4000);

        // Close overlay
        closeOverlay();

        // Optionally reset login? keep logged in for demo.
        // Reset fields
        uidInput.value = '';
        trxInput.value = '';
        screenshotInput.value = '';
        fileNameDisplay.textContent = 'No file selected';
        currentScreenshotFile = null;
        selectedPack = null;
      });

      function showError(message) {
        errorText.textContent = message;
        errorMsg.style.display = 'flex';
        errorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          // keep visible but allow auto-hide after 6 sec? no.
        }, 100);
      }

      // ---------- Event listeners for closing ----------
      closeOverlayBtn.addEventListener('click', closeOverlay);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeOverlay();
      });

      // ---------- Init ----------
      renderPacks();

      // Extra: if user clicks "login prompt" we already have a handler, but also inside overlay
      // The login prompt is inside overlay. Works.

      // Make sure "login" required: if not logged in and clicking a pack, open order panel is blocked.
      // We already have that in openOrderPanel.

      // Also if the user taps login prompt, it sets isLoggedIn = true, but doesn't auto open any pack.
      // That's fine.

      // If user is not logged in but overlay is somehow opened (e.g., via console) – we still show login prompt.
      // But we want to prevent overlay unless logged in. Already handled.

      // For demo: show login prompt highlight initially?
      // Not needed.

      // Reset error on input changes
      uidInput.addEventListener('input', () => errorMsg.style.display = 'none');
      trxInput.addEventListener('input', () => errorMsg.style.display = 'none');

    })();
  </script>
</body>
</html>
